# Super Agent 环境变量配置模板
# 复制为 .env 并填入实际值
#
# ⚠️  安全提示：
#    1. .env 已被 .gitignore 排除（见 .gitignore:10），确保不要将含密钥的 .env 提交到 Git！
#    2. 真实 API Key / Secret 严禁出现在本模板（.env.example）或任何仓库文件。
#    3. 若密钥不慎泄露：立即到对应控制台吊销并重发，必要时 git filter-repo 清理历史。

# ==================== 基础配置 ====================
PORT=3000
HOST=0.0.0.0

# ==================== 安全：加密密钥（必填）====================
# 用于加密数据库中存储的 LLM API Key 与第三方服务凭据（AES-256-CBC）。
# 未设置或使用弱密钥时进程将拒绝启动。
# 生成强密钥（任选其一）：
#   方式一（推荐）： openssl rand -hex 32
#   方式二（Node） ： node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SA_ENCRYPTION_KEY=
# 过渡期专用：若升级自旧版本且数据库中已有凭证，填入原先使用的旧 SA_ENCRYPTION_KEY。
# 启动后日志出现 "[migration] ... re-encrypted" 即完成自动迁移，之后即可删除本行。
# SA_ENCRYPTION_KEY_LEGACY=

# ==================== LLM Providers ====================
# 阿里 DashScope（Qwen 系列）
DASHSCOPE_API_KEY=
# DeepSeek
DEEPSEEK_API_KEY=
# 智谱 GLM
ZHIPU_API_KEY=
# Moonshot（Kimi）
MOONSHOT_API_KEY=
# MiniMax
MINIMAX_API_KEY=
# OpenAI（可选）
OPENAI_API_KEY=
# 本地 Ollama（默认地址）
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ==================== 火山方舟（图片生成）====================
ARK_API_KEY=
ARK_ENDPOINT_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ==================== Video-Forge 微服务 ====================
# Python 视频微服务 URL（默认 http://127.0.0.1:8199）
VIDEO_FORGE_URL=http://127.0.0.1:8199
# 设为 true 禁止自动启动 video-forge（手动启动时使用）
DISABLE_VIDEO_FORGE=false

# RunningHub API Key（ComfyUI 云端工作流）
# 在 https://www.runninghub.com 注册获取
RUNNINGHUB_API_KEY=

# ComfyUI 本地部署地址（Phase 3 selfhost 模式使用）
# COMFYUI_URL=http://127.0.0.1:8188

# ==================== IM Gateway ====================
# 注意：首次使用前需在 services/im-gateway/ 目录手动安装 Python 依赖：
#   cd services/im-gateway && uv sync  （或：pip install -e .）
#
# 设为 true 禁止自动启动 IM Gateway
DISABLE_IM_GATEWAY=false
# IM Gateway URL（默认 http://localhost:8642）
IM_GATEWAY_URL=http://localhost:8642

# ==================== 认证 ====================
# JWT 密钥（用于 Web UI 登录）
# JWT_SECRET=your-secret-key
# 默认 API Key（用于 REST API 认证）
# API_KEY=your-api-key

# ==================== 可选功能开关 ====================
# 系统操作工具总开关
# SUPER_AGENT_SYSOPS_ENABLED=true
# 运维工具
# SUPER_AGENT_OPS_TOOLS=true
# 开发辅助工具
# SUPER_AGENT_DEV_TOOLS=true
# 桌面控制工具
# SUPER_AGENT_DESKTOP_TOOLS=true
# Computer Use Loop
# SUPER_AGENT_COMPUTER_USE=true

# ==================== 代码执行沙箱（SEC-P0-03）====================
# run_python / run_javascript / run_shell 默认对"用户自定义 Agent"禁用，避免直接以宿主进程权限执行任意代码。
# 内置系统级 Agent（metadata.isBuiltin=true，如 ResearchCrew / DataAnalyst）走白名单，不受以下开关影响。
#
# 开启方式（任选其一）：
#   1. 兼容旧开关：设置 SUPER_AGENT_CODE_EXEC_ENABLED=true，等价于 process 级沙箱
#   2. 精确控制沙箱等级：SUPER_AGENT_SANDBOX_LEVEL=process|docker|container（推荐生产使用 docker）
# 仅在可信环境下启用。
# SUPER_AGENT_CODE_EXEC_ENABLED=true
# SUPER_AGENT_SANDBOX_LEVEL=process

# A2A 协议端点
# ENABLE_A2A=true

# 全链路追踪
# ENABLE_TRACING=true
