# ====== 环境配置模板（v3 Task 0b）======
# 用途：新机部署时执行 cp .env.example .env 后填入真实值
# 注意：所有占位符为空字符串，不含任何真实凭据或密钥
#
# 敏感信息管理：
#   开发环境：填入 .env（已加入 .gitignore）
#   生产环境：推荐使用 Vault 加密存储，/env 仅在 VAULT_ALLOW_ENV_FALLBACK=true 时兜底

# ====== 运行环境 ======
NODE_ENV=production
PORT=3001

# ====== LLM 模型提供商 ======
# 主模型配置（前端页面可动态切换）
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 备用提供商
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# ====== 安全与鉴权 ======
# API 鉴权（Task 12）—— 生产环境必须设为 true
AUTH_ENABLED=false
# 凭据保险柜主密钥（32字符随机字符串，缺失时开发环境自动生成临时密钥）
CREDENTIAL_MASTER_KEY=
# 密钥升级兼容（旧密钥需配置此项以解密历史数据）
SA_ENCRYPTION_KEY_LEGACY=
# IM 网关内部鉴权（Task 4）—— INTERNAL_TOKEN + INTERNAL_HMAC_SECRET 配对使用
INTERNAL_TOKEN=
INTERNAL_HMAC_SECRET=

# ====== 语音识别 (STT) ======
STT_API_URL=
STT_API_KEY=
STT_MODEL=whisper-1
# Groq 降级链路（免费层级可用）
GROQ_API_KEY=
STT_GROQ_MODEL=whisper-large-v3-turbo
# 阿里云实时语音转写（可选）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_APPKEY=

# ====== IM 网关 ======
IM_GATEWAY_URL=http://localhost:8642
IM_GATEWAY_API_KEY=
# 设为 true 可彻底禁用 IM 网关（开发调试用）
DISABLE_IM_GATEWAY=false

# ====== Video Forge 视频生成 ======
RUNNINGHUB_API_KEY=
RUNNINGHUB_STD_BASE_URL=
COMFYUI_BASE_URL=
RUNNINGHUB_INSTANCE_TYPE=
# 设为 true 可彻底禁用视频生成服务（开发调试用）
DISABLE_VIDEO_FORGE=false
VIDEO_FORGE_RELOAD=0

# ====== 功能开关 (Feature Flags) ======
# 标准化响应壳（Task 3）—— 生产环境设为 true
FEATURE_FLAG_RESP_ENVELOPE=false
# IM 网关内部 HMAC 鉴权（Task 4）
FEATURE_FLAG_INTERNAL_AUTH=false
# zod → OpenAPI 代码生成（Task 6）
FEATURE_FLAG_ZOD_CODEGEN=false
# OpenTelemetry 全链路追踪（Task 7）
FEATURE_FLAG_OTEL_TRACING=false
# LLM 语义缓存（Task 10）
FEATURE_FLAG_LLM_CACHE=false
# CommandGuard 接管（Task 2）
FEATURE_FLAG_GUARDED_EXEC=false
# 错误码双轨兼容期标志（Task 11）
ERROR_CODE_DUAL_EMIT=true
# Vault 未就绪时允许从 .env 兜底
VAULT_ALLOW_ENV_FALLBACK=true
# Vault fail-fast（生产环境触发异常）
SA_VAULT_FAIL_FAST=false

# ====== 存储路径 ======
DATA_DIR=./data
# 覆盖默认 Agent Home 目录（不设置则用 DATA_DIR）
SA_HOME=
# 多 Agent 协作文件交付目录
COLLAB_FILES_DIR=

# ====== 运行时 ======
# 开启调试日志
DEBUG=0
# 开启 Docker 沙箱执行
ENABLE_DOCKER_SANDBOX=0
# FFmpeg/FFprobe 便携版下载地址（空则自动从默认源下载）
FFMPEG_DOWNLOAD_URL=
FFPROBE_DOWNLOAD_URL=
# Python UV 包管理器镜像源（国内加速）
UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# 自动扩展 Agent 能力（实验性）
SUPER_AGENT_AUTO_EXPAND_CAPABILITIES=false
# 自动安装缺失依赖（实验性）
SUPER_AGENT_AUTO_INSTALL_DEPS=false
# 禁用知识库解析侧车（节省资源）
DISABLE_KB_PARSER_SIDECAR=false
