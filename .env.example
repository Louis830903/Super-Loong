# ============================================================
# Super Agent 环境变量配置模板
#
# ✅ 无需填写任何 API Key 即可启动！
#    启动后在浏览器设置页面配置即可：http://localhost:3000/settings
#
# 使用方法：复制此文件为 .env，然后按需修改
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# 💡 以下 API Key 变量仅用于 Docker / CI/CD 等自动化场景的预播种，
#    普通用户无需编辑，直接通过设置页面配置更安全、更方便。
#    env 中的值仅在数据库无记录时写入一次，不会覆盖设置页面的修改。
# ============================================================

# ─── 基础设施（仅 env 可配，无 UI 入口）──────────────────

# HTTP 服务端口（默认 3001）
# PORT=3001

# 监听地址（默认 0.0.0.0，Docker 部署不要改）
# HOST=0.0.0.0

# 日志级别：debug / info / warn / error（默认 info）
# LOG_LEVEL=info

# 前端地址（CORS 白名单，默认已包含 localhost:3000）
# FRONTEND_URL=http://localhost:3000

# 启用认证（默认关闭，生产环境建议开启）
# AUTH_ENABLED=false

# 平台标识（注入到 Agent 提示词，如 windows / macos / linux）
# PLATFORM=windows

# 全链路追踪（默认关闭）
# ENABLE_TRACING=false

# 关闭 IM Gateway（默认开启）
# DISABLE_IM_GATEWAY=false

# ─── 安全配置 ─────────────────────────────────────────────

# API Key 加密密钥（⚠️ 生产环境必须设置，32+ 字符随机字符串）
# 不设置则使用内置默认密钥（仅开发环境可接受）
# SA_ENCRYPTION_KEY=your-random-32-char-string-here

# ─── 大模型 API Key（可选 — 高级 / Docker / CI/CD 场景）──
#
# 💡 普通用户无需填写，启动后在设置页面配置即可
#    以下变量仅在数据库无记录时写入一次，之后请通过设置页面管理
#
# Moonshot AI (Kimi)   — https://platform.kimi.com
# MOONSHOT_API_KEY=
#
# 智谱 AI (GLM)        — https://open.bigmodel.cn
# ZHIPU_API_KEY=
#
# 通义千问 (Qwen)      — https://dashscope.console.aliyun.com
# （同时驱动记忆系统高级向量检索引擎）
# QWEN_API_KEY=
#
# DeepSeek             — https://platform.deepseek.com
# DEEPSEEK_API_KEY=
#
# MiniMax              — https://platform.minimaxi.com
# MINIMAX_API_KEY=

# ─── 旧版兼容（不推荐，建议使用上方 Provider 独立 Key）──
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=

# ─── 外部服务（可选 — 启动后在设置页面配置即可）─────────

# 阿里云语音 TTS/STT — https://nls-portal.console.aliyun.com
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# ALIBABA_CLOUD_APPKEY=

# 火山方舟 Seedream（AI 图片生成）— https://console.volcengine.com/ark
# ARK_API_KEY=
# ARK_ENDPOINT_ID=

# 视觉分析（图片分析/OCR）
# VISION_API_KEY=
# VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VISION_MODEL=

# ─── SSH 沙箱（远程执行隔离，可选）───────────────────────
# SSH_SANDBOX_HOST=
# SSH_SANDBOX_USER=
# SSH_SANDBOX_PORT=22
# SSH_SANDBOX_KEY_PATH=
# SSH_SANDBOX_PASSWORD=
# SSH_SANDBOX_TIMEOUT=30000
# SSH_SANDBOX_WORKDIR=/tmp/sa-sandbox
