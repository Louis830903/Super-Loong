# =============================================================
# Super Agent — 环境变量模板（v3 Task 0b）
#
# 用途：
#   cp .env.example .env
#   然后填入真实值（切勿将 .env 提交到版本控制）
#
# 说明：
#   - 带 * 的变量为生产必填
#   - 带 # 注释的为可选项
#   - 所有值默认留空，部分有内联默认值供参考
# =============================================================

# ─── 服务基础配置 ────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# ─── LLM Provider（至少填一个）*─────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=

# 各 Provider 专用 API Key（可不填，走 LLM_API_KEY 统一路径）
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
GROQ_API_KEY=
ARK_API_KEY=
ARK_BASE_URL=
ARK_ENDPOINT_ID=
STT_API_KEY=
STT_API_URL=
STT_MODEL=
STT_GROQ_MODEL=

# ─── 认证与安全 *─────────────────────────────────────────────
# AUTH_ENABLED=false           # 设置 true 开启 JWT 认证
AUTH_ENABLED=false
AUTH_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 内部服务间通信 HMAC Token
INTERNAL_TOKEN=
INTERNAL_HMAC_SECRET=
IM_GATEWAY_API_KEY=

# API 密钥列表（逗号分隔，多租户场景）
SUPER_AGENT_API_KEYS=

# 凭据加密主密钥
CREDENTIAL_MASTER_KEY=
SA_ENCRYPTION_KEY=
SA_ENCRYPTION_KEY_LEGACY=
SA_VAULT_FAIL_FAST=false
VAULT_ALLOW_ENV_FALLBACK=true

# A2A 协议 Token
# ENABLE_A2A=false
A2A_TOKEN=

# ─── 数据目录 ────────────────────────────────────────────────
SA_HOME=
DATA_DIR=
COLLAB_FILES_DIR=

# ─── 飞书（Feishu）渠道 ─────────────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# ─── 企业微信（Wecom）渠道 ───────────────────────────────────
# （在 Web 设置页配置，无需填此处）

# ─── 钉钉（DingTalk）渠道 ───────────────────────────────────
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=

# ─── 语音服务（阿里云）──────────────────────────────────────
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_APPKEY=

# ─── 数据库（可选，默认用 SQLite）────────────────────────────
# DATABASE_URL=

# ─── 外部服务集成 ────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# ─── 子进程服务地址 ──────────────────────────────────────────
IM_GATEWAY_URL=http://127.0.0.1:8200
VIDEO_FORGE_URL=http://127.0.0.1:8199
API_BASE_URL=http://127.0.0.1:3001
BASE_URL=http://127.0.0.1:3001

# ─── SSH 沙箱（可选）────────────────────────────────────────
SSH_SANDBOX_HOST=
SSH_SANDBOX_PORT=22
SSH_SANDBOX_USER=
SSH_SANDBOX_PASSWORD=
SSH_SANDBOX_KEY_PATH=
SSH_SANDBOX_WORKDIR=/tmp/sandbox
SSH_SANDBOX_TIMEOUT=30000

# ─── 浏览器自动化（可选）────────────────────────────────────
BROWSER_PATH=
BROWSER_WS_ENDPOINT=

# ─── 视频合成（可选）────────────────────────────────────────
VIDEO_CONCURRENCY_MAX=2
VIDEO_FORGE_IMAGE_TIMEOUT_MS=120000
FFMPEG_DOWNLOAD_URL=
FFPROBE_DOWNLOAD_URL=

# ─── 速率限制 ────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Feature Flags（v3 双轨切换）─────────────────────────────
FEATURE_FLAG_RESP_ENVELOPE=false
FEATURE_FLAG_GUARDED_EXEC=false
FEATURE_FLAG_INTERNAL_AUTH=false

# ─── OpenTelemetry（v3 T7，可选）─────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=super-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SAMPLE_RATE=0.1

# ─── 进化引擎开关（可选）────────────────────────────────────
REFLECTION_ENABLED=false
SUPER_AGENT_AUTO_EXPAND_CAPABILITIES=false
SUPER_AGENT_AUTO_INSTALL_DEPS=false

# ─── 能力控制（可选）────────────────────────────────────────
SUPER_AGENT_CODE_EXEC_ENABLED=false
SUPER_AGENT_COMPUTER_USE=false
SUPER_AGENT_DESKTOP_TOOLS=false
SUPER_AGENT_DEV_TOOLS=false
SUPER_AGENT_OPS_TOOLS=false
SUPER_AGENT_SYSOPS_ENABLED=false
ENABLE_DOCKER_SANDBOX=false
SUPER_AGENT_SANDBOX_LEVEL=none
MAX_WS_CLIENTS=50
ENABLE_TRACING=false
SUPER_AGENT_NO_VERSION_CHECK=false

# ─── 代理（可选）────────────────────────────────────────────
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ─── Python 依赖（可选）─────────────────────────────────────
UV_INDEX_URL=
