# Super Agent 环境变量配置模板
# 复制为 .env 并填入实际值
#
# ⚠️  安全提示：
#    1. .env 已被 .gitignore 排除（见 .gitignore），确保不要将含密钥的 .env 提交到 Git！
#    2. 真实 API Key / Secret 严禁出现在本模板（.env.example）或任何仓库文件中。
#    3. 若密钥不慎泄露：立即到对应控制台吊销并重发，必要时 git filter-repo 清理历史。

# ── API Server ──────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# ── Frontend URL (for CORS) ─────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── LLM Provider ────────────────────────────────────────
# 支持：openai / anthropic / ollama / 及任何 OpenAI 兼容 API
# 常见国内厂商：Kimi (Moonshot)、千问 (DashScope)、DeepSeek、豆包 (Ark)、智谱GLM、MiniMax
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 以下为各厂商独立 Key（系统会自动探测并注入到对应模型供应商）
# DASHSCOPE_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
# ZHIPU_API_KEY=xxx
# MOONSHOT_API_KEY=sk-xxx
# MINIMAX_API_KEY=xxx
# 本地 Ollama（默认地址）
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── JWT Secret (for API authentication) ─────────────────
JWT_SECRET=change-this-to-a-random-string

# ── IM Gateway ──────────────────────────────────────────
IM_GATEWAY_URL=http://localhost:8642
# 设为 true 禁用 IM 网关
# DISABLE_IM_GATEWAY=true

# ── 全链路追踪 ──────────────────────────────────────────
# 也可通过 Dashboard UI 开关动态切换
ENABLE_TRACING=false

# ── 运行平台 ────────────────────────────────────────────
# desktop / web / mobile，用于 prompt 差异化提示
PLATFORM=desktop

# ── 凭据加密 ────────────────────────────────────────────
# AES-256-CBC 加密密钥（32 字节 base64），首次启动自动生成
# 生成强密钥（任选其一）：
#   方式一（推荐）： openssl rand -hex 32
#   方式二（Node） ： node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# SA_ENCRYPTION_KEY=
# 旧密钥回退（解密历史数据用，解密成功后自动用新密钥重加密迁移）
# SA_ENCRYPTION_KEY_LEGACY=
# 凭据主密钥（用于 CredentialVault 加密持久化）
# CREDENTIAL_MASTER_KEY=

# ── 数据库 ──────────────────────────────────────────────
# 自定义 SQLite 数据库路径（默认 ~/.super-agent/data/super-agent.db）
# SA_DB_PATH=/path/to/custom.db

# ── STT 语音识别（Whisper API）──────────────────────────
# 如果你的 LLM Provider 不支持 Whisper endpoint（如 Kimi），请独立设置：
# STT_API_URL=https://api.openai.com
# STT_API_KEY=sk-xxx
# STT_MODEL=whisper-1
#
# 注意：系统会 fallback 到 LLM_API_KEY 尝试 Whisper（OpenAI 用户可零配置）

# ── Groq Whisper（免费 STT，非 OpenAI 用户的零配置方案）───
# 去 https://console.groq.com/keys 免费获取 API Key，填入下方：
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# ── 阿里云语音识别（企业级，可选）───────────────────────
# ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret
# ALIBABA_CLOUD_APPKEY=your-appkey

# ── 视觉模型（豆包 Seedream / 图像生成）─────────────────
# ARK_API_KEY=your-ark-api-key
# ARK_ENDPOINT_ID=your-endpoint-id
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VISION_API_KEY=your-vision-api-key
# VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VISION_MODEL=doubao-vision-pro-32k

# ── SysOps 系统操作工具集 ───────────────────────────────
# 启用终端引擎及所有子模块
# SUPER_AGENT_SYSOPS_ENABLED=true
# SUPER_AGENT_OPS_TOOLS=true
# SUPER_AGENT_DEV_TOOLS=true
# SUPER_AGENT_DESKTOP_TOOLS=true
# SUPER_AGENT_COMPUTER_USE=true

# ── 代码执行沙箱 ────────────────────────────────────────
# Sandbox 级别: none / basic / full
# SUPER_AGENT_SANDBOX_LEVEL=basic
# 启用代码执行工具
# SUPER_AGENT_CODE_EXEC_ENABLED=true

# ── Docker 沙箱（可选）──────────────────────────────────
# ENABLE_DOCKER_SANDBOX=0

# ── 版本检查 ────────────────────────────────────────────
# 自定义当前版本号（默认读取 package.json）
# SUPER_AGENT_VERSION=0.1.0
# 禁用版本检查
# SUPER_AGENT_NO_VERSION_CHECK=false

# ── Video Forge ─────────────────────────────────────────
# Python 视频微服务 URL（默认 http://127.0.0.1:8199）
# VIDEO_FORGE_URL=http://127.0.0.1:8199
# 设为 true 禁止自动启动 video-forge（手动启动时使用）
# DISABLE_VIDEO_FORGE=false
# RunningHub API Key（ComfyUI 云端工作流）
# 在 https://www.runninghub.com 注册获取
# RUNNINGHUB_API_KEY=
# ComfyUI 本地部署地址（Phase 3 selfhost 模式使用）
# COMFYUI_URL=http://127.0.0.1:8188

# ── 知识库 Docling Sidecar ─────────────────────────────
# 设为 true 禁用知识库高级文档解析（PDF/Word/PPT 等）
# DISABLE_KB_PARSER_SIDECAR=true

# ── A2A 协议 ────────────────────────────────────────────
# 启用 Agent-to-Agent 跨进程通信
# ENABLE_A2A=true

# ── Python/venv 自举 ────────────────────────────────────
# UV pip 镜像源（默认阿里云镜像，国内用户加速安装）
# UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# ── FFmpeg 下载（自举用）────────────────────────────────
# FFMPEG_DOWNLOAD_URL=https://example.com/ffmpeg.zip
# FFPROBE_DOWNLOAD_URL=https://example.com/ffprobe.zip
