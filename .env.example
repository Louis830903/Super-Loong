# ============================================================
#  Super Agent 环境变量配置模板
#  复制为 .env 并填入实际值：
#    Windows:  copy .env.example .env
#    macOS/Linux: cp .env.example .env
# ============================================================

# === 必填：加密密钥（首次运行 pnpm setup 时自动生成）===
# 用于加密持久化存储中的敏感数据（API Key、Token 等）
SA_ENCRYPTION_KEY=

# === 必填：至少配置一个 LLM Provider 的 API Key ===
# 阿里 DashScope（推荐，Qwen 系列性价比最高，国产合规）
DASHSCOPE_API_KEY=
# DeepSeek V3/V4（高性能推理）
DEEPSEEK_API_KEY=
# 智谱 GLM（国产旗舰）
ZHIPU_API_KEY=
# Moonshot Kimi（超长上下文）
MOONSHOT_API_KEY=
# 火山方舟（豆包/Seed 系列）
ARK_API_KEY=
# MiniMax（多模态理解与生成）
MINIMAX_API_KEY=
# OpenAI（可选，GPT 系列）
OPENAI_API_KEY=

# === 可选：视频生成（需要 RunningHub 账号）===
RUNNINGHUB_API_KEY=
# RunningHub 工作流模板 ID（逗号分隔，可选）
# RUNNINGHUB_WORKFLOW_IDS=

# === 可选：本地模型（无需 API Key）===
# Ollama 服务地址（默认自动检测 http://127.0.0.1:11434）
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# === 可选：语音服务（STT/TTS）===
# 阿里云语音服务（AccessKey）
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# 自定义 STT 服务
# STT_API_URL=
# STT_API_KEY=

# === 可选：高级配置 ===
# 服务端口（默认值适用于大多数场景）
# PORT=3001
# HOST=0.0.0.0
# LOG_LEVEL=info
# NODE_ENV=development
# 前端地址（CORS 白名单）
# FRONTEND_URL=http://localhost:3000
# 生产环境 JWT 密钥（不设置则每次重启随机生成）
# JWT_SECRET=
# 系统运维模式（允许危险操作，生产环境请勿开启）
# SUPER_AGENT_SYSOPS_ENABLED=false
