# ─────────────────────────────────────────────────────────
#  Super Agent 生产环境变量
#  基于 .env.example，差异化内容用于生产模式
#
#  ⚠️ 安全警告：
#    1. JWT_SECRET 和 SA_ENCRYPTION_KEY 必须手动填写强密钥！
#    2. 不要将此文件提交到 Git（已在 .gitignore 中排除）
#    3. 生产环境建议 LOG_LEVEL=warn 减少日志噪音
#
#  使用方式：
#    1. 复制 .env.example → .env.production
#    2. 修改下方必填项
#    3. start.bat / start.sh 一键启动
# ─────────────────────────────────────────────────────────

# === 生产环境必填 ===
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# JWT 密钥（必须修改！）
# 生成方式：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# 凭据加密密钥（必须修改！）
# 生成方式：openssl rand -hex 32
SA_ENCRYPTION_KEY=

# === 生产环境推荐 ===
LOG_LEVEL=warn        # 减少日志噪音（可选：info / warn / error）
FRONTEND_URL=http://localhost:3000

# === LLM Provider（至少配置一个）===
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 其他厂商独立 Key（可选）
# DASHSCOPE_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
# ZHIPU_API_KEY=xxx
# MOONSHOT_API_KEY=sk-xxx
# MINIMAX_API_KEY=xxx
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# === IM 网关 ===
# Gateway 由 API 内部 GatewayLauncher 自动管理，无需单独启动
IM_GATEWAY_URL=http://localhost:8642
# 如不需要 IM 功能，取消下行注释
# DISABLE_IM_GATEWAY=true

# === 视频 Forge ===
# 如不需要视频功能，取消下行注释
# DISABLE_VIDEO_FORGE=true

# === 知识库 Docling（高级文档解析）===
# 如不需要 PDF/Word/PPT 解析，取消下行注释
# DISABLE_KB_PARSER_SIDECAR=true

# === A2A 协议（Agent-to-Agent 跨进程通信）===
# ENABLE_A2A=true

# === 全链路追踪 ===
ENABLE_TRACING=false

# === 运行平台 ===
PLATFORM=desktop

# === 其余配置项请参考 .env.example ===
# 包括：STT 语音识别、视觉模型、SysOps 系统操作、代码沙箱、
#       Docker 沙箱、版本检查、Python/venv 自举等
