{
  "name": "@super-agent/web-types",
  "version": "0.1.0",
  "private": true,
  "description": "前后端共享的纯类型与纯运行时常量，零 Node-only 依赖（禁止引入 sql.js/pino/fs 等 Node API）",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "clean": "rimraf dist"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "devDependencies": {
    "rimraf": "^6.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  }
}
