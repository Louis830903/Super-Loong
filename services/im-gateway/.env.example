# ============================================================
#  IM Gateway 环境变量配置模板
#  复制为 .env 并填入实际值：
#    Windows:  copy .env.example .env
#    macOS/Linux: cp .env.example .env
# ============================================================

# === Super Agent API 连接 ===
# API 服务地址（默认本地 3001 端口）
SUPER_AGENT_API_URL=http://localhost:3001
# API 鉴权密钥（在 Super Agent 后台「设置 > API 密钥」生成）
SUPER_AGENT_API_KEY=
# 默认 Agent ID（IM 消息默认转发的 Agent）
DEFAULT_AGENT_ID=

# === 企业微信（至少配置一个渠道）===
# 在企业微信管理后台获取 Corp ID 和 Secret
# WECOM_CORP_ID=
# WECOM_SECRET=
# WECOM_AGENT_ID=
# WECOM_BOT_ID=
# WECOM_TOKEN=
# WECOM_ENCODING_AES_KEY=
# 自定义 WebSocket 地址（可选，默认自动拼接）
# WECOM_WEBSOCKET_URL=

# === 飞书 ===
# 在飞书开放平台创建企业自建应用，获取 App ID 和 App Secret
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=
# 连接模式：websocket（推荐）或 webhook
# FEISHU_MODE=websocket

# === 钉钉 ===
# 在钉钉开放平台创建应用，获取 Client ID 和 Client Secret
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=
# DINGTALK_ROBOT_CODE=
