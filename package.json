{
  "name": "super-agent",
  "version": "0.1.0",
  "private": false,
  "description": "模块化通用 AI Agent 平台 — 持久记忆 · 自我进化 · 多智能体协作 · 知识库 · 视频生成 · IM 网关",
  "repository": {
    "type": "git",
    "url": "https://github.com/Louis830903/Super-Loong"
  },
  "author": "Louis830903",
  "license": "MIT",
  "keywords": [
    "ai-agent",
    "multi-agent",
    "llm",
    "knowledge-base",
    "video-generation",
    "im-gateway",
    "self-evolution",
    "persistent-memory",
    "typescript",
    "nextjs"
  ],
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @super-agent/api dev",
    "dev:web": "pnpm --filter @super-agent/web dev",
    "dev:monitor": "pnpm --filter @super-agent/monitor dev",
    "dev:gateway": "cd services/im-gateway && python server.py",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @super-agent/api build",
    "build:web": "pnpm --filter @super-agent/web build",
    "start:prod": "pm2 start ecosystem.config.cjs --env production",
    "stop:prod": "pm2 stop ecosystem.config.cjs",
    "restart:prod": "pm2 restart ecosystem.config.cjs",
    "logs:prod": "pm2 logs super-agent-api",
    "status:prod": "pm2 status",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @super-agent/core test",
    "test:api": "pnpm --filter @super-agent/api test",
    "test:web": "pnpm --filter @super-agent/web test",
    "test:e2e": "pnpm --filter @super-agent/e2e test",
    "test:all": "pnpm test:core && pnpm test:api && pnpm test:web",
    "test:ci": "pnpm test:core && pnpm test:api && pnpm test:web",
    "clean": "pnpm -r clean",
    "check:sensitive": "node scripts/check-sensitive-files.mjs",
    "check:sensitive:ci": "node scripts/check-sensitive-files.mjs --ci",
    "check:empty-catch": "node scripts/check-empty-catch.mjs",
    "check:empty-catch:staged": "node scripts/check-empty-catch.mjs --staged",
    "check:why": "node scripts/check-why-comments.mjs",
    "check:why:staged": "node scripts/check-why-comments.mjs --staged",
    "gen:openapi": "pnpm --filter @super-agent/api gen:openapi",
    "gen:types": "pnpm --filter @super-agent/api gen:types",
    "gen:types:check": "pnpm --filter @super-agent/api gen:types:check"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "skillhub": "^0.2.11"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.0",
      "@types/react-dom": "18.3.0",
      "zod@^3.0.0": "3.25.76"
    }
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
